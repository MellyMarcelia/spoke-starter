{
  "color": {
    "$type": "color",
    "surface": { "$value": "#ffffff" },
    "text": {
      "primary": { "$value": "#1a1a1a" },
      "muted": { "$value": "#6b6660" }
    },
    "border": { "$value": "#e4e0d8" },
    "brand": { "$value": "#e8552b" },
    "on-brand": { "$value": "#ffffff" },
    "tag": {
      "background": { "$value": "#fcebe4" },
      "text": { "$value": "#b23e16" }
    },
    "error": { "$value": "#c62828" }
  },
  "space": {
    "$type": "dimension",
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "pill": { "$value": "999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Inter", "system-ui", "sans-serif"] }
    }
  },
  "typography": {
    "$type": "typography",
    "screen": {
      "title": {
        "$value": { "fontFamily": "{font.family.base}", "fontWeight": 600, "fontSize": "28px", "lineHeight": "34px", "letterSpacing": "0px" }
      }
    },
    "card": {
      "title": {
        "$value": { "fontFamily": "{font.family.base}", "fontWeight": 600, "fontSize": "20px", "lineHeight": "28px", "letterSpacing": "0px" }
      },
      "body": {
        "$value": { "fontFamily": "{font.family.base}", "fontWeight": 400, "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0px" }
      },
      "caption": {
        "$value": { "fontFamily": "{font.family.base}", "fontWeight": 400, "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0px" }
      }
    },
    "label": {
      "button": {
        "$value": { "fontFamily": "{font.family.base}", "fontWeight": 600, "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0px" }
      },
      "field": {
        "$value": { "fontFamily": "{font.family.base}", "fontWeight": 500, "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0px" }
      },
      "tag": {
        "$value": { "fontFamily": "{font.family.base}", "fontWeight": 500, "fontSize": "13px", "lineHeight": "18px", "letterSpacing": "0px" }
      }
    }
  }
}
